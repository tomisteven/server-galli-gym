# ==== Base de datos MongoDB ====
MONGO_URI=

# ==== Servidor ====
PORT=5000

# ==== Cloudinary (fotos de perfil) ====
CLOUDINARY_NAME=
API_KEY_CLOUDINARY=
API_SECRET_CLOUDINARY=

# ==== Autenticación de administradores (JWT) ====
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Credenciales del admin que crea `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=